  "lang": "ru",
  "cps": 14,
  "lines": {
    "n01": "Ты решил покрасить забор.",
    "n02": "Ведра точно хватит.",
    "n03": "Краска кончилась на середине.",
    "n04": "Купил такую же. Почти.",
    "n05": "Пока ходил, первый участок облупился.",
    "n06": "Ничего. Покрасим заново.",
    "n07": "С самого начала."
  }
}